# ─── HTTP-сервер ───────────────────────────────────────────────
PORT=3000

# ─── База даних PostgreSQL ─────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=sports_club_db
PGUSER=postgres
PGPASSWORD=your_db_password

# ─── Автентифікація ────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# ─── Email для двофакторної автентифікації (2FA) ───────────────
# Необов'язково. Якщо SMTP_HOST не задано — коди НЕ надсилаються поштою,
# а друкуються в консоль сервера (зручно для локального тестування).
# Приклад для Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 (app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@sixseven.local
# Діагностика 2FA: за DEBUG_OTP=1 код дублюється в консоль сервера навіть
# із налаштованим SMTP (зручно для тестових акаунтів). НЕ вмикати у проді.
DEBUG_OTP=1

# ─── АІ-асистент (локальна LLM через Ollama) ───────────────────
# Необов'язково. Якщо Ollama не запущено, асистент відповість 503,
# решта системи працює як звичайно.
# Встановлення: brew install ollama && ollama pull qwen3:8b
# У Docker замість localhost використовуйте host.docker.internal.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Повністю контейнерний запуск АІ (docker compose --profile ollama up):
# розкоментуйте рядок нижче — app-контейнер піде до ollama-контейнера,
# а модель завантажиться автоматично при першому старті.
# На macOS це повільніше за нативну Ollama (немає доступу до GPU).
# OLLAMA_DOCKER_URL=http://ollama:11434
