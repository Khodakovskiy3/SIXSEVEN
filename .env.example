# ═══════════════════════════════════════════════════════════════
#  Cluvyra — environment variables
#  Copy to .env for local development. NEVER commit real secrets.
#  Production (Railway): set these in the service "Variables" tab.
# ═══════════════════════════════════════════════════════════════

# ─── Runtime ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Run migrations on boot (local dev). On Railway use the pre-deploy
# command `npm run db:migrate` and set RUN_MIGRATIONS_ON_START=false.
RUN_MIGRATIONS_ON_START=true
# Background jobs (reminders, planned messages). Keep true on exactly one instance.
JOBS_ENABLED=true

# ─── Brand / organisation ──────────────────────────────────────
PRODUCT_NAME=Cluvyra
ORGANIZATION_NAME=OLIMP Demo
APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
# Public contact shown on the landing page. Leave empty until a real mailbox exists.
SUPPORT_EMAIL=
APP_TIMEZONE=Europe/Kyiv

# ─── Database ──────────────────────────────────────────────────
# Production: DATABASE_URL (Railway: ${{Postgres.DATABASE_URL}}) takes priority.
DATABASE_URL=
# Set true only when connecting over a network that requires TLS (e.g. Railway public proxy).
DATABASE_SSL=false
# Local development fallback (docker compose up -d db):
PGHOST=localhost
PGPORT=5432
PGDATABASE=sports_club_db
PGUSER=postgres
PGPASSWORD=

# ─── Authentication ────────────────────────────────────────────
# Required in production, ≥ 32 random chars:  openssl rand -hex 32
JWT_SECRET=
JWT_TTL=7d

# Comma-separated list of extra origins allowed to call the API cross-origin.
# Leave empty: the frontend is served from the same origin.
CORS_ORIGIN=

# ─── Email (verification codes, 2FA) ───────────────────────────
# Without SMTP in production, registration and admin/manager sign-in
# return 503 (codes are never exposed). Any SMTP provider works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Local development only: 1 = print codes to the console and return them
# as `devCode` (useful without SMTP). Forbidden in production.
DEBUG_OTP=0

# ─── AI assistant ──────────────────────────────────────────────
AI_ENABLED=true
# anthropic (production) | ollama (optional local development)
AI_PROVIDER=anthropic
# Server-side only. Never expose to the browser, PWA or Electron.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. For lower cost: claude-sonnet-5-5 or claude-haiku-4-5.
ANTHROPIC_MODEL=
# low | medium | high (Opus/Sonnet 5.x). Chat booking works well on low.
ANTHROPIC_EFFORT=low
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_MAX_TOOL_ROUNDS=6
AI_HISTORY_LIMIT=16
AI_REQUESTS_PER_MINUTE=6
AI_DAILY_REQUEST_LIMIT=60
AI_BOOKING_TOKEN_TTL_MIN=10
BOOKING_HORIZON_DAYS=60

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ─── Uploads ───────────────────────────────────────────────────
# Production: Railway volume mounted at /data → UPLOADS_DIR=/data/uploads
UPLOADS_DIR=
UPLOAD_MAX_BYTES=5242880

# ─── Web Push (optional) ───────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ─── Demo ──────────────────────────────────────────────────────
# Allows `npm run demo:seed -- --confirm` in production (synthetic data only).
DEMO_MODE=false

# ─── Local HTTPS proxy (docker compose "caddy" service) ────────
SITE_ADDRESS=localhost
# UPSTREAM=host.docker.internal:3000
# OLLAMA_DOCKER_URL=http://ollama:11434
